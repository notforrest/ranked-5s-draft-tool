# Copy this file to .env and fill in your own values.
# Riot personal developer keys expire ~24h after generation --
# get a fresh one from https://developer.riotgames.com/ and paste it here before each session.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Default routing for account-v1 / match-v5 (regional): americas | asia | europe
RIOT_ACCOUNT_REGION=americas

# Default routing for summoner-v4 / champion-mastery-v4 (platform): na1 | euw1 | kr | ...
RIOT_PLATFORM_REGION=na1
