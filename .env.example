# Copy this file to .env and fill in your own values.
# Riot personal developer keys expire ~24h after generation --
# get a fresh one from https://developer.riotgames.com/ and paste it here before each session.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Default routing for account-v1 / match-v5 (regional): americas | asia | europe
RIOT_ACCOUNT_REGION=americas

# Default routing for summoner-v4 / champion-mastery-v4 (platform): na1 | euw1 | kr | ...
RIOT_PLATFORM_REGION=na1

# Optional. Grab the current download link from https://oracleselixir.com/tools/downloads
# by hand (direct CSV link, or a Google Sheets "export as CSV" URL) and paste it here so the
# setup screen's "Fetch Oracle's Elixir data" button can pull it automatically. The link isn't
# stable forever -- re-check it once per split or if the fetch starts failing. Leave blank to
# just use the "Upload CSV" option in the UI instead.
ORACLES_ELIXIR_CSV_URL=

# Start of the current ranked season/year (YYYY-MM-DD). Personal stats, role eligibility, and
# roster synergy/matchup data are all scoped to matches on or after this date -- bump it once a
# year when a new season starts (check leagueoflegends.com's ranked announcement). Set it to a
# specific split's start date instead (e.g. the most recent one) if you'd rather scope to the
# current 4-month split than the full ranked year.
CURRENT_SEASON_START_DATE=2026-01-08
